{
  "$schema": "./node_modules/void/schema.json",
  "output": "static",
  "routing": {
    "redirects": {
      "/article/*": {
        "to": "/articles/:splat",
        "status": 301
      }
    }
  },
  "head": {
    "title": "Liang",
    "htmlAttrs": {
      "lang": "en"
    },
    "meta": [
      {
        "charset": "utf-8"
      },
      {
        "name": "viewport",
        "content": "width=device-width, initial-scale=1"
      },
      {
        "name": "description",
        "content": "Liang's Growth Timeline"
      }
    ],
    "link": [
      {
        "rel": "icon",
        "type": "image/x-icon",
        "href": "/favicon.ico"
      },
      {
        "rel": "preconnect",
        "href": "https://fonts.googleapis.com"
      },
      {
        "rel": "preconnect",
        "href": "https://fonts.gstatic.com",
        "crossorigin": ""
      },
      {
        "rel": "stylesheet",
        "href": "https://fonts.googleapis.com/css2?family=Nunito:wght@900&family=Inter:wght@400;500&family=Inter+Tight:wght@500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500&display=swap"
      }
    ]
  },
  "worker": {
    "compatibility_date": "2026-02-24"
  }
}
