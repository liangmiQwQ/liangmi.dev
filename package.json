{
  "name": "liangmi-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run metadata && pnpm run social-images && pnpm run sitemap && vp run cbuild",
    "cdev": "pnpm run metadata && pnpm run social-images && pnpm run sitemap && pnpm run dev",
    "check": "vp run ccheck",
    "deploy": "pnpm run metadata && pnpm run social-images && pnpm run sitemap && void deploy --platform cloudflare",
    "dev": "vp dev",
    "lint": "vp run clint",
    "lint:fix": "vp lint --fix",
    "metadata": "tsx scripts/run.ts",
    "prepare": "vp config",
    "preview": "vp preview",
    "sitemap": "tsx scripts/sitemap.ts",
    "social-images": "tsx scripts/social-images.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "marked": "catalog:",
    "motion-v": "catalog:website"
  },
  "devDependencies": {
    "@iconify-json/ph": "catalog:website",
    "@iconify-json/streamline-cyber": "catalog:",
    "@liangmi/vp-config": "catalog:",
    "@types/node": "catalog:types",
    "@types/to-ico": "catalog:types",
    "@void/md": "catalog:void",
    "@void/vue": "catalog:void",
    "@vueuse/core": "catalog:website",
    "dotenv": "catalog:cli",
    "sharp": "catalog:",
    "to-ico": "catalog:cli",
    "tsx": "catalog:cli",
    "typescript": "catalog:types",
    "unocss": "catalog:website",
    "vite": "catalog:void",
    "vite-plus": "catalog:",
    "void": "catalog:void",
    "vue": "catalog:void",
    "vue-tsc": "catalog:types",
    "wrangler": "catalog:void"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@10.33.0"
}
